# Supabase public renderer configuration. Never place a secret/service_role key here.
# Production uses HTTPS; local development may use http://127.0.0.1:54321.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# production for Vercel Production/Electron package; staging or test for configured Preview.
NEXT_PUBLIC_THREADLINE_CLOUD_ENV=
